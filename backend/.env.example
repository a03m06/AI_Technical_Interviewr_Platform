# Copy this file to .env and fill in your values (or export these directly).

# Required for real question generation, resume parsing, and evaluation.
# Omit this and everything runs against the mock LLM instead -- useful for
# testing the graph/API without burning API credits, but scores/questions
# won't be meaningful.
OPENAI_API_KEY=sk-...

# Optional -- defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Optional -- "sqlite" (default, persists sessions to a local file) or
# "memory" (in-process only, lost on restart -- useful for quick tests).
CHECKPOINTER=sqlite

# Optional -- where the sqlite session DB lives. Defaults to
# backend/data/sessions.sqlite if unset.
CHECKPOINTER_DB_PATH=data/sessions.sqlite
